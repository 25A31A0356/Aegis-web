# =================================================================
# 🛡️ AEGIS ALERT WEB — Environment Configuration
# =================================================================

# --- Base Map Providers ---
# The platform works 100% out of the box with free OpenStreetMap & CARTO tiles (NO KEY REQUIRED).
# If you wish to use premium Mapbox or Google Maps styles, you can supply optional tokens below:

# Optional: Mapbox Public Token (from https://account.mapbox.com/)
VITE_MAPBOX_ACCESS_TOKEN=

# Optional: Google Maps Platform API Key (from https://console.cloud.google.com/google/maps-apis)
VITE_GOOGLE_MAPS_API_KEY=

# --- Meteorological Radar & Live Weather APIs ---
# Optional: OpenWeatherMap API Key (from https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=

# Optional: TomTom / HERE Emergency Traffic Routing Key
VITE_ROUTING_API_KEY=
